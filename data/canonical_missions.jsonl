{"id":"gold-001","mission":"Use the baseline AntRobot deployment.","expected":{"capabilities":{}},"expected_template_configuration":{}}
{"id":"gold-002","mission":"Map the environment using the default odometry pipeline.","expected":{"capabilities":{"mapping":{"enabled":true},"odometry":{"enabled":true,"implementation":"kinematic_icp","selection_basis":"explicit"}}},"expected_template_configuration":{"launch.launch_cartographer":true,"launch.launch_kinematic_icp":true,"launch.launch_kiss_icp":false,"launch.launch_laserscan_to_pointcloud":false}}
