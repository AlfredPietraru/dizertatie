{"id":"gold-005","mission":"Use KISS-ICP instead of kinematic ICP.","expected":{"capabilities":{"odometry":{"enabled":true,"implementation":"kiss_icp","selection_basis":"explicit"}}},"expected_template_configuration":{"launch.launch_kinematic_icp":false,"launch.launch_kiss_icp":true,"launch.launch_laserscan_to_pointcloud":true}}
{"id":"gold-006","mission":"Use kinematic ICP for odometry.","expected":{"capabilities":{"odometry":{"enabled":true,"implementation":"kinematic_icp","selection_basis":"explicit"}}},"expected_template_configuration":{"launch.launch_kinematic_icp":true,"launch.launch_kiss_icp":false,"launch.launch_laserscan_to_pointcloud":false}}
{"id":"gold-007","mission":"Enable autonomous exploration while mapping.","expected":{"capabilities":{"mapping":{"enabled":true},"exploration":{"enabled":true}}},"expected_template_configuration":{"launch.launch_cartographer":true,"launch.enable_explore_lite":true,"launch.explore_lite":true}}
