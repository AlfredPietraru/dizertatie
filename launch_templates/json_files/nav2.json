{
  "template": "generator_launch_file.py.j2",
  "output_filename": "nav2.launch.py",
  "launch_arguments": [
    {
      "result_name": "use_sim_time_arg",
      "name": "use_sim_time",
      "default": "false",
      "description": "Use simulation (Gazebo) clock if true"
    },
    {
      "result_name": "params_file_arg",
      "name": "params_file",
      "default": {
        "type": "path_join_substitution",
        "parts": [
          {"type": "find_package_share", "package": "antrobot_ros"},
          "config",
          "nav2_params.yaml"
        ]
      },
      "description": "Full path to the ROS2 parameters file to use"
    },
    {
      "result_name": "map_arg",
      "name": "map",
      "default": {
        "type": "path_join_substitution",
        "parts": [
          {"type": "find_package_share", "package": "antrobot_ros"},
          "maps",
          "map.yaml"
        ]
      },
      "description": "Full path to map yaml file to load"
    }
  ],
  "computed_paths": [],
  "parameter_loaders": [],
  "parameter_extractions": [],
  "nodes": [],
  "included_launch_files": [
    {
      "result_name": "nav2_bringup_launch",
      "source": {
        "type": "path_join_substitution",
        "parts": [
          {"type": "find_package_share", "package": "nav2_bringup"},
          "launch",
          "bringup_launch.py"
        ]
      },
      "launch_arguments": [
        {"name": "use_sim_time", "value": "use_sim_time"},
        {"name": "params_file", "value": "params_file"},
        {"name": "map", "value": "map"}
      ]
    }
  ],
  "launch_description": [
    "use_sim_time_arg",
    "params_file_arg",
    "map_arg",
    "nav2_bringup_launch"
  ]
}
