{
  "baseline_profile": "profiles/baseline.yaml",
  "schema_version": "3.0",
  "templates": [
    {
      "deployment_strategy": "package_overlay",
      "install_target": "share/antrobot_ros/config/antrobot_params.yaml",
      "output": "config/antrobot_params.yaml",
      "path": "config/antrobot_params.yaml.j2"
    },
    {
      "deployment_strategy": "package_overlay",
      "install_target": "share/antrobot_ros/config/explore_lite_params.yaml",
      "output": "config/explore_lite_params.yaml",
      "path": "config/explore_lite_params.yaml.j2"
    },
    {
      "deployment_strategy": "wrapper_launch",
      "output": "launch/antrobot_profile.launch.py",
      "path": "launch/antrobot_profile.launch.py.j2"
    }
  ],
  "wiring_bindings": {
    "wiring.base_link_frame": {
      "baseline_value": "base_link",
      "parameter_keys": [
        "nodes.explore.robot_base_frame",
        "nodes.kinematic_icp.base_frame",
        "nodes.kiss_icp.base_frame",
        "nodes.rdrive_node.base_frame_id"
      ]
    },
    "wiring.joint_states_topic": {
      "baseline_value": "joint_states",
      "parameter_keys": [
        "nodes.joint_state_estimator.joint_state_topic"
      ]
    },
    "wiring.map_explore_topic": {
      "baseline_value": "map_explore",
      "parameter_keys": [
        "nodes.explore.costmap_topic",
        "nodes.explore.output_map_topic"
      ]
    },
    "wiring.map_topic": {
      "baseline_value": "map",
      "parameter_keys": [
        "nodes.explore.input_map_topic"
      ]
    },
    "wiring.map_updates_explore_topic": {
      "baseline_value": "map_updates_explore",
      "parameter_keys": [
        "nodes.explore.costmap_updates_topic",
        "nodes.explore.output_map_updates_topic"
      ]
    },
    "wiring.map_updates_topic": {
      "baseline_value": "map_updates",
      "parameter_keys": [
        "nodes.explore.input_map_updates_topic"
      ]
    },
    "wiring.odom_frame": {
      "baseline_value": "odom",
      "parameter_keys": [
        "nodes.kinematic_icp.lidar_odom_frame",
        "nodes.kiss_icp.lidar_odom_frame"
      ]
    },
    "wiring.odom_topic": {
      "baseline_value": "odom",
      "parameter_keys": [
        "nodes.kinematic_icp.lidar_odometry_topic",
        "nodes.kiss_icp.odom_topic"
      ]
    },
    "wiring.odom_wheel_frame": {
      "baseline_value": "odom_wheel",
      "parameter_keys": [
        "nodes.kinematic_icp.wheel_odom_frame",
        "nodes.rdrive_node.odom_frame_id"
      ]
    },
    "wiring.odom_wheel_topic": {
      "baseline_value": "odom_wheel",
      "parameter_keys": [
        "nodes.joint_state_estimator.odom",
        "nodes.rdrive_node.odom_topic"
      ]
    },
    "wiring.scan_pointcloud_topic": {
      "baseline_value": "scan_pointcloud",
      "parameter_keys": [
        "nodes.laserscan_to_pointcloud.pointcloud_topic"
      ]
    },
    "wiring.scan_topic": {
      "baseline_value": "scan",
      "parameter_keys": [
        "nodes.kinematic_icp.lidar_topic",
        "nodes.laserscan_to_pointcloud.scan_topic"
      ]
    }
  }
}
