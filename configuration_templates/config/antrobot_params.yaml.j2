    max_velocity_jump: {{ values["nodes.rdrive_node.max_velocity_jump"] | yaml_scalar }}
rplidar:
  ros__parameters:
    serial_port: "/dev/ttyUSB0"
    serial_baudrate: 115200
    frame_id: "rplidar_link"
    inverted: false
    angle_compensate: true
    scan_mode: "Sensitivity"
joint_state_estimator:
  ros__parameters:
    odom: {{ derived["wiring.odom_wheel_topic"] | yaml_scalar }}
    joint_states_topic: {{ derived["wiring.joint_states_topic"] | yaml_scalar }}
    use_icp_estimation: {{ values["nodes.joint_state_estimator.use_icp_estimation"] | yaml_scalar }}
    wheel_velocity_correction_factor: {{ values["nodes.joint_state_estimator.wheel_velocity_correction_factor"] | yaml_scalar }}
    wheel_radius: {{ platform["nodes.joint_state_estimator.wheel_radius"] | yaml_scalar }}
    wheel_separation: {{ platform["nodes.joint_state_estimator.wheel_separation"] | yaml_scalar }}
    publish_frequency: {{ values["nodes.joint_state_estimator.publish_frequency"] | yaml_scalar }}
robot_state:
  ros__parameters:
    description_package: "antrobot_description"
    description_file: "antrobot.xacro"
    joint_states_topic: "joint_states"
    publish_frequency: 20.0
    ignore_timestamp: false
    frame_prefix: ""
tf_static:
  ros__parameters:
    transforms: [{"parent_frame": "base_link", "child_frame": "base_footprint", "translation": [0.0, 0.0, -0.035], "rotation": [0.0, 0.0, 0.0]}, {"parent_frame": "base_link", "child_frame": "laser_link", "translation": [0.0, 0.0, 0.155], "rotation": [0.0, 0.0, 0.0]}]
    publish_transforms: false
laserscan_to_pointcloud:
