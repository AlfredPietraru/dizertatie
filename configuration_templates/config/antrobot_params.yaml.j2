    no_load_rpm_right: {{ platform["nodes.rdrive_node.no_load_rpm_right"] | yaml_scalar }}
    odom_frequency: {{ values["nodes.rdrive_node.odom_frequency"] | yaml_scalar }}
    odom_topic: {{ derived["wiring.odom_wheel_topic"] | yaml_scalar }}
    publish_tf: {{ values["nodes.rdrive_node.publish_tf"] | yaml_scalar }}
    invert_odom_tf: {{ values["nodes.rdrive_node.invert_odom_tf"] | yaml_scalar }}
