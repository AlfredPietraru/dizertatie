    scan_topic: {{ derived["wiring.scan_topic"] | yaml_scalar }}
    pointcloud_topic: {{ derived["wiring.scan_pointcloud_topic"] | yaml_scalar }}
    include_point_timestamp: {{ values["nodes.laserscan_to_pointcloud.include_point_timestamp"] | yaml_scalar }}
