rdrive:
  ros__parameters:
    wheel_radius: {{ platform["nodes.rdrive_node.wheel_radius"] | yaml_scalar }}
    wheel_separation: {{ platform["nodes.rdrive_node.wheel_separation"] | yaml_scalar }}
    encoder_cpr_left: {{ platform["nodes.rdrive_node.encoder_cpr_left"] | yaml_scalar }}
    encoder_cpr_right: {{ platform["nodes.rdrive_node.encoder_cpr_right"] | yaml_scalar }}
